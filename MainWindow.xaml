<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Content-Aware Funny Face" Height="850" Width="660"
        WindowStartupLocation="CenterScreen" 
        Background="#F4F6F8" 
        FontFamily="Segoe UI" 
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        SizeToContent="Manual">

    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#4361EE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#4361EE"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A56D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bordered TabControl -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Tab Strip with border -->
                            <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0" Padding="8,8,8,0">
                                <TabPanel IsItemsHost="True" Background="Transparent"/>
                            </Border>

                            <!-- Content Area with border -->
                            <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                <ContentPresenter ContentSource="SelectedContent" Margin="0"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabItem with border and shade -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="#CBD5E1" 
                        BorderThickness="1,1,1,0"
                        CornerRadius="4,4,0,0"
                        Padding="{TemplateBinding Padding}" 
                        Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#1E293B"/>
                                <Setter TargetName="Border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter TargetName="Border" Property="Margin" Value="0,-1,2,0"/>
                                <Setter TargetName="Border" Property="Padding" Value="16,9"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1E293B"/>
                                <Setter TargetName="Border" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <Style TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#4361EE"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border x:Name="TrackBackground" Height="4" Background="{TemplateBinding Background}" CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{TemplateBinding Foreground}" Stroke="#FFFFFF" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBoxBorder" Width="16" Height="16" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="3" Margin="0,0,6,0">
                                <Path x:Name="CheckMark" Data="M 1,4 L 4,7 L 9,1" Stroke="#FFFFFF" StrokeThickness="2" Visibility="Collapsed" Margin="2"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#4361EE"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#4361EE"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="RadioBorder" Width="16" Height="16" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8" Margin="0,0,6,0">
                                <Ellipse x:Name="CheckMark" Fill="#4361EE" Width="8" Height="8" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioBorder" Property="BorderBrush" Value="#4361EE"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#4361EE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <!-- The crucial fix: Added x:Name="PART_Track" so WPF can measure it -->
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="100"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF1E293B" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10,20,12">
            <TextBlock Text="Content Aware Face Distortion Meme Maker" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontFamily="Comic Sans MS" RenderTransformOrigin="0.385,0.48">
                <TextBlock.Foreground>
                    <RadialGradientBrush SpreadMethod="Reflect">
                        <RadialGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                <SkewTransform CenterX="0.5" CenterY="0.5"/>
                                <RotateTransform CenterX="0.5" CenterY="0.5"/>
                                <TranslateTransform X="0"/>
                            </TransformGroup>
                        </RadialGradientBrush.RelativeTransform>
                        <GradientStop Color="#FFFFED28"/>
                        <GradientStop Color="#FF62F2FD" Offset="1"/>
                    </RadialGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
        </Border>

        <TabControl x:Name="tabMain" Grid.Row="1" Margin="20,16,20,0">

            <TabItem Header="Img2Vid" BorderBrush="#FFACACAC" Background="#FFE2E8F0">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Image Path" Width="75" VerticalAlignment="Center" Foreground="#64748B" FontSize="12" FontWeight="Bold"/>
                            <TextBox x:Name="txtImagePath" Width="360" Margin="0,0,10,0" BorderBrush="#FF717171"/>
                            <Button Content="Browse" Width="80" Style="{StaticResource SecondaryButton}" Click="BtnBrowseImage_Click" BorderBrush="#FF99B7DE"/>
                        </StackPanel>

                        <Border Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Distortion Style Tuning" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Frames" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBox x:Name="txtFrames" Width="55" Text="60" HorizontalContentAlignment="Center" Margin="0,0,20,0"/>
                                        <TextBlock Text="Intensity" VerticalAlignment="Center" Foreground="#64748B" FontSize="12" Margin="0,0,12,0"/>
                                        <Slider x:Name="sliderIntensity" Width="140" Minimum="10" Maximum="80" Value="40" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ElementName=sliderIntensity, Path=Value, StringFormat={}{0}%}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#4361EE"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Text="Jitter" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="sliderJitter" Width="220" Minimum="0" Maximum="100" Value="25" TickFrequency="10" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ElementName=sliderJitter, Path=Value, StringFormat={}{0}%}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#4361EE"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="6" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Video Export" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="chkConvertVideo" Content="Convert to video" IsChecked="True" Margin="0,0,20,0"/>
                                    <TextBlock Text="Framerate:" VerticalAlignment="Center" Foreground="#64748B" FontSize="12" Margin="0,0,10,0"/>
                                    <RadioButton x:Name="rbFps12" Content="12 fps" GroupName="FpsImgGroup" IsChecked="True"/>
                                    <RadioButton x:Name="rbFps24" Content="24 fps" GroupName="FpsImgGroup"/>
                                    <RadioButton x:Name="rbFps30" Content="30 fps" GroupName="FpsImgGroup"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Vid2Vid (Uniform)">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,0" Padding="16,6,16,11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Video Path" Width="75" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                            <TextBox x:Name="txtStaticVideoPath" Width="360" Margin="0,0,10,0"/>
                            <Button Content="Browse" Width="80" Style="{StaticResource SecondaryButton}" Click="BtnBrowseStaticVideo_Click"/>
                        </StackPanel>

                        <Border Background="#FFF7ED" CornerRadius="6" Padding="10" Margin="0,0,0,12" BorderBrush="#FED7AA" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️" Margin="0,0,6,0" FontSize="12"/>
                                <TextBlock Text="Same distortion every frame. Use Seed/Bias to target face!" 
                                          TextWrapping="Wrap" Foreground="#9A3412" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Constant Distortion Settings" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Intensity" Width="70" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                                    <Slider x:Name="sliderStaticVidIntensity" Width="180" Minimum="10" Maximum="80" Value="40" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ElementName=sliderStaticVidIntensity, Path=Value, StringFormat={}{0}%}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#4361EE"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Jitter" Width="70" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                                    <Slider x:Name="sliderStaticVidJitter" Width="180" Minimum="0" Maximum="100" Value="25" TickFrequency="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ElementName=sliderStaticVidJitter, Path=Value, StringFormat={}{0}%}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#4361EE"/>
                                    <TextBlock Text="Seed" Width="40" VerticalAlignment="Center" Foreground="#64748B" FontSize="12" Margin="20,0,0,0"/>
                                    <TextBox x:Name="txtStaticSeed" Width="55" Text="42" HorizontalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Face Bias" Width="70" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                                    <Slider x:Name="sliderStaticBias" Width="220" Minimum="-150" Maximum="150" Value="-50" TickFrequency="25" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ElementName=sliderStaticBias, Path=Value}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#4361EE"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnPreviewEnergyMap" Content="🔍 Heatmap" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="BtnPreviewEnergyMap_Click"/>
                            <Button x:Name="btnPreviewStaticFrame" Content="🖼️ Preview" Style="{StaticResource PrimaryButton}" Click="BtnPreviewStaticFrame_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Vid2Vid (Progressive)">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,0" BorderBrush="#FF1D63C1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Video Path" Width="75" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                            <TextBox x:Name="txtVideoPath" Width="360" Margin="0,0,10,0"/>
                            <Button Content="Browse" Width="80" Style="{StaticResource SecondaryButton}" Click="BtnBrowseVideo_Click"/>
                        </StackPanel>

                        <Border Background="#F0FDF4" CornerRadius="6" Padding="10" Margin="0,0,0,12" BorderBrush="#BBF7D0" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💡" Margin="0,0,6,0" FontSize="12"/>
                                <TextBlock Text="Distortion increases from 0% to target % over time making melting effect" 
                                          TextWrapping="Wrap" Foreground="#166534" FontSize="11" Width="367"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" CornerRadius="6" Padding="12" BorderBrush="#FF0C63D6" BorderThickness="1" Height="143" Width="580">
                            <StackPanel>
                                <TextBlock Text="Progressive Settings" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Max Intensity" Width="116" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                                    <Slider x:Name="sliderVidIntensity" Width="180" Minimum="10" Maximum="80" Value="40" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Value, ElementName=sliderVidIntensity, StringFormat=\{0\}%}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#4361EE"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Jitter" Width="70" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                                    <Slider x:Name="sliderVidJitter" Width="180" Minimum="0" Maximum="100" Value="25" TickFrequency="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Value, ElementName=sliderVidJitter, StringFormat=\{0\}%}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#4361EE"/>
                                    <TextBlock Text="Seed" Width="40" VerticalAlignment="Center" Foreground="#64748B" FontSize="12" Margin="20,0,0,0"/>
                                    <TextBox x:Name="txtVidSeed" Width="55" Text="42" HorizontalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Face Bias" Width="70" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                                    <Slider x:Name="sliderVidBias" Width="220" Minimum="-150" Maximum="150" Value="-50" TickFrequency="25" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Value, ElementName=sliderVidBias}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#4361EE"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Render preview at"
                                       Foreground="#64748B"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <Button x:Name="btnPreviewProgHalf" Content="🌗 50%" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="BtnPreviewProgHalf_Click" Background="#FF4361EE" Foreground="#FFECECEC">
                                <Button.FocusVisualStyle>
                                    <Style/>
                                </Button.FocusVisualStyle>
                            </Button>
                            <Button x:Name="btnPreviewProgFull" Content="🌕 100%" Style="{StaticResource PrimaryButton}" Click="BtnPreviewProgFull_Click" Foreground="#FFECECEC" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="20,0,20,0" Height="185" VerticalAlignment="Top" Padding="16,0,16,16">
            <StackPanel>
                <TextBlock Text="Performance Safeguards" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Batch Size" Width="85" VerticalAlignment="Center" Foreground="#FF8B6464" FontSize="12" FontWeight="Medium" FontStyle="Italic"/>
                    <Slider x:Name="sliderBatchSize" Width="180" Minimum="1" Maximum="20" Value="6" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ElementName=sliderBatchSize, Path=Value}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#FFEE4343" Width="25"/>
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#94A3B8" FontSize="11" FontStyle="Italic" Width="187"><Run Text="Higher = Faster, "/><Run Text="("/><Run FontWeight="Bold" Text="more CPU uses"/><Run Text=")"/></TextBlock>
                </StackPanel>

                <CheckBox x:Name="chkEnableScaling" Content="Limit input resolution to preserve VRAM" IsChecked="True" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Max Edge:" Width="85" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                    <RadioButton x:Name="rbSize400" Content="400px (Fast)" GroupName="SizeGroup" Margin="0,0,12,0"/>
                    <RadioButton x:Name="rbSize600" Content="600px (Balanced)" GroupName="SizeGroup" IsChecked="True" Margin="0,0,12,0"/>
                    <RadioButton x:Name="rbSize1200" Content="1200px (HQ)" GroupName="SizeGroup"/>
                </StackPanel>

                <CheckBox x:Name="chkLimitFps" Content="Limit video framerate (skip frames to reduce render time)" IsChecked="True" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Max FPS:" Width="85" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                    <RadioButton x:Name="rbFpsLimit15" Content="15 fps" GroupName="FpsLimitGroup" Margin="0,0,12,0"/>
                    <RadioButton x:Name="rbFpsLimit30" Content="30 fps" GroupName="FpsLimitGroup" IsChecked="True" Margin="0,0,12,0"/>
                    <RadioButton x:Name="rbFpsLimitNone" Content="No Limit" GroupName="FpsLimitGroup"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="20,-21,20,12">
            <Button x:Name="btnStart" Content="Start Processing" FontSize="14" FontWeight="SemiBold" 
                    Style="{StaticResource PrimaryButton}" Padding="0,12" 
                    Click="BtnStart_Click" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-8,0,10">
                <Button Content="Open Frames Folder" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="BtnOpenFrames_Click"/>
                <Button Content="Open Videos Folder" Style="{StaticResource SecondaryButton}" Click="BtnOpenVideos_Click"/>
            </StackPanel>

            <TextBlock x:Name="lblStatus" Text="Ready" FontSize="12" Foreground="#059669" HorizontalAlignment="Center" Margin="0,-11,0,6" FontWeight="Medium"/>
            <ProgressBar x:Name="progressBar" Height="6" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,10"/>
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,2,12,12" Height="157">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="60"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Processing Log" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtLog" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                            Background="#1E293B" Foreground="#A5F3FC" FontFamily="Consolas" FontSize="11" 
                            TextWrapping="Wrap" Padding="8" BorderThickness="0" Margin="0,0,0,-9"/>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>